# Postgres connection string (Neon / Vercel Postgres / Supabase — any Postgres works).
# Not required while UI_ONLY=true.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs session cookies. Set this to a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Set to "true" to run the app with realistic in-memory mock data and no
# database at all — useful for a first deploy before a Postgres DB is wired
# up. Auth is auto-allowed and every account works as Administrator.
UI_ONLY="true"
